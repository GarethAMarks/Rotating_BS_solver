# Rotating mini boson stars with m = 3, kappa = 8 pi, from the analytic torus seed straight into
# arclength continuation toward lower omega, down to the near-extremal end of the family
# (omega ~ 0.4193, M ~ 3.5791, 2 omega M / m - 1 ~ 5e-4, J/M^2 = 0.99996; 97 models). About 10 min
# (solver clock) on one core; 600 radial points agree with these 400 to 6e-6 in J/M^2.
# Seeds for higher m start at omega = 0.95, where the star is nearly Newtonian; the torus seed
# needs a radius close to the star's: rot_seed_width = 12-16 (m = 3), 20 (m = 4, 5), amp 0.01.
# Nr matters, Ntheta does not (31 and 81 agree to 1e-5). The radial grid is mostly a logarithmic
# band (radial_log_fraction): the core keeps shrinking geometrically near the end of the family,
# and a log band resolves it without the regrid jumps of the point clusters.
# radial_scale_min_mass keeps the far field (r >> M) resolved.
# Run from the repository root:  ./rotating_bs_solver examples/rotating_mini_m3.par
sequence_mode = rotating
continuation_mode = arclength
potential = mini
matter = scalar
m_azimuthal = 3
Nr = 400
Ntheta = 31
radial_grid = adaptive
radial_scale = 5
radial_scale_min_mass = 0.03
radial_log_fraction = 0.6
radial_cluster_fraction = 0
kappa_target = 25.132741228718345
omega_target = 0.95
rot_seed_amp = 0.01
rot_seed_width = 12
delta_omega = 0.01
arclength_max_steps = 600
first_law_tol = 0.02
corotating_radius = 0.4
wall_resolution_tol = 0.5
max_newton_iters = 30
